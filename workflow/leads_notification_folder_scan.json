{
  "name": "Leads Notification - Folder Scan",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nconst leads = staticData.pendingLeads || [];\n\nstaticData.pendingLeads = [];\n\nif (leads.length === 0) {\n  return [];\n}\n\nconst listHtml = leads.map(lead => {\n  return `<li><b>${lead.video}</b>: ${lead.Nome}, ${lead.Email}, filled at ${lead['Horário de Preenchimento']}</li>`;\n}).join('');\n\nreturn [{ json: { emailBody: `<ul>${listHtml}</ul>`, count: leads.length } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -960,
        1296
      ],
      "id": "8c13910b-c837-4695-8b7e-b933cb9c3851",
      "name": "Build summary email"
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 9
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -1408,
        1104
      ],
      "id": "4b0ae7c4-6a55-48a4-998c-d1c87a308e11",
      "name": "Every day at 9am"
    },
    {
      "parameters": {
        "resource": "fileFolder",
        "returnAll": true,
        "filter": {
          "folderId": {
            "__rl": true,
            "value": "YOUR_GOOGLE_DRIVE_FOLDER_ID",
            "mode": "list",
            "cachedResultName": "Leads Sheets"
          }
        },
        "options": {}
      },
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        -1184,
        1104
      ],
      "id": "690c3b43-a0e2-448b-be2e-e37053d0b913",
      "name": "List files in Leads Sheets",
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "YOUR_CREDENTIAL_ID",
          "name": "Google Drive account"
        }
      }
    },
    {
      "parameters": {
