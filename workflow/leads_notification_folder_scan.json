      },
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        -960,
        1104
      ],
      "id": "c575e345-ba24-4891-9129-289ea4b4c442",
      "name": "Loop Over Items"
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $json.id }}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "list",
          "value": "gid=0"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        -720,
        992
      ],
      "id": "b0269278-a01e-4064-a889-75c6fe9f1c0a",
      "name": "Read leads",
      "alwaysOutputData": true,
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "YOUR_CREDENTIAL_ID",
          "name": "Google Sheets account"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nconst fileId = $('Loop Over Items').item.json.id;\nconst videoName = $('Loop Over Items').item.json.name;\n\nlet rows = $input.all().map(item => item.json);\nrows = rows.filter(row => row.Nome !== undefined || row.Email !== undefined);\n\nconst lastCount = staticData[fileId] || 0;\nconst currentCount = rows.length;\n\nstaticData[fileId] = currentCount;\n\nif (!staticData.pendingLeads) {\n  staticData.pendingLeads = [];\n}\n\nif (currentCount > lastCount) {\n  const newRows = rows.slice(lastCount);\n  for (const row of newRows) {\n    staticData.pendingLeads.push({ ...row, video: videoName });\n  }\n}\n\nreturn [{ json: { fileId, checked: true } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -512,
        992
      ],
      "id": "72990df4-64fe-4752-934a-4ee855809dfd",
      "name": "Check for new rows"
    },
    {
      "parameters": {
        "sendTo": "YOUR_EMAIL@example.com",
        "subject": "=New leads today: {{ $json.count }}",
        "message": "={{ $json.emailBody }}",
        "options": {
          "appendAttribution": false
        }
      },
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        -720,
        1296
      ],
      "id": "35579683-4050-432f-b515-6ab71422a732",
